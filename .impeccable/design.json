  "narrative": {
    "northStar": "A Small Personal Development Environment",
    "overview": "The workspace is a quiet, working desktop: deep ink outside, opaque blue-black windows inside, warm chalk text and a small handwritten signature behind the windows. A generous background terminal carries the real ASCII lettering, prompt and file paths. About and Contact start open in front of it, with About active.\n\nWindow chrome is restrained and familiar. Orange identifies the current path, focus and selected task; lilac distinguishes the prompt and directories. The layout leaves room around a centered welcome, then becomes denser when commands produce useful output. Markdown documents share the same visual language and overlap the terminal as working windows.",
    "keyCharacteristics": [
      "Real character-based identity and navigation.",
      "Opaque, bordered windows on a deep ink desktop.",
      "Warm chalk reading text with orange activity and lilac prompts.",
      "A small script signature reserved for the desktop background.",
      "Recoverable windows and one active surface on compact screens."
    ],
    "rules": [
      {
        "name": "The Activity Rule.",
        "body": "Use orange to identify an action, current state or focus; retain warm chalk for sustained reading.",
        "section": "colors"
      },
      {
        "name": "The Character Integrity Rule.",
        "body": "Render the identity as preformatted text in Geist Mono; preserve the character grid as the terminal changes size.",
        "section": "typography"
      },
      {
        "name": "The Recoverable Workspace Rule.",
        "body": "Keep the task strip and Reset accessible as windows move, close or minimize; compact screens show one active window at a time.",
        "section": "layout"
      }
    ],
    "dos": [],
    "donts": []
  }
