      "description": "Plain file action that adopts orange on hover or focus.",
      "html": "<button type=\"button\" class=\"ds-path ds-path-default\"><span aria-hidden=\"true\">&gt;</span>cv/</button>",
      "css": ".ds-path{display:flex;gap:12px;align-items:center;min-height:36px;padding:3px 12px 3px 0;font-size:16px;text-align:left;border:0;border-radius:4px;background:none;cursor:pointer;font-family:'Geist Mono',monospace;}.ds-path>span{width:14px;color:transparent}.ds-path:hover,.ds-path:focus-visible{background:#ff985215;color:var(--orange,#ff9852)}.ds-path:hover>span{color:var(--orange,#ff9852)}.ds-path:focus-visible{outline:2px solid var(--orange,#ff9852);outline-offset:4px;}.ds-path-default{color:var(--ink,#eeeae5)}"
    },
    {
      "name": "Command input",
      "kind": "input",
      "refersTo": "command-input",
      "description": "Borderless prompt row with an orange focus rule and caret.",
      "html": "<form class=\"ds-command\"><label for=\"ds-input\"><span class=\"ds-user\">omar</span><span class=\"ds-punctuation\">:</span><span class=\"ds-path-label\">~</span><span class=\"ds-punctuation\">$</span></label><input id=\"ds-input\" aria-label=\"Terminal command\" type=\"text\" spellcheck=\"false\" autocomplete=\"off\"></form>",
      "css": ".ds-command{display:flex;align-items:baseline;gap:10px;min-height:28px;background:var(--surface,#0c1421);font-family:'Geist Mono',monospace;}.ds-command label{flex:0 1 auto;max-width:45%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:14px}.ds-user{color:var(--lilac,#c39af4)}.ds-path-label{color:#c5c0f1}.ds-punctuation{color:var(--muted,#a3afc3)}.ds-command input{min-width:0;flex:1;height:29px;padding:0;color:var(--ink,#eeeae5);background:transparent;border:0;border-radius:0;font:inherit;font-size:14px;caret-color:var(--orange,#ff9852)}.ds-command input:focus{outline:none}.ds-command:focus-within{box-shadow:0 1px 0 var(--orange,#ff9852)}"
    },
    {
      "name": "Window controls",
      "kind": "button",
      "refersTo": "window-controls",
      "description": "Conventional colored window dots reveal their symbols on hover or focus.",
      "html": "<div class=\"ds-controls\"><button class=\"ds-control ds-close\" type=\"button\" aria-label=\"Close window\"><span aria-hidden=\"true\">×</span></button><button class=\"ds-control ds-minimize\" type=\"button\" aria-label=\"Minimize window\"><span aria-hidden=\"true\">−</span></button><button class=\"ds-control ds-maximize\" type=\"button\" aria-label=\"Maximize window\"><span aria-hidden=\"true\">+</span></button></div>",
      "css": ".ds-controls{display:flex;gap:8px;align-items:center;padding:12px;background:var(--chrome,#182231)}.ds-control{position:relative;width:12px;height:12px;min-width:12px;border:0;border-radius:50%;padding:0;color:#17202e;line-height:12px;font-size:12px;font-weight:700;cursor:pointer;font-family:'Geist Mono',monospace;}.ds-control:after{content:\"\";position:absolute;inset:-6px -3px}.ds-control span{opacity:0}.ds-controls:hover span,.ds-controls:focus-within span{opacity:1}.ds-close{background:#ff706b}.ds-minimize{background:#eac463}.ds-maximize{background:#69bd7b}.ds-control:focus-visible{outline:2px solid var(--orange,#ff9852);outline-offset:4px;}"
    },
    {
      "name": "Document window",
      "kind": "card",
      "refersTo": "document-window",
      "description": "Opaque framed reading surface with a restrained title bar and Markdown markers.",
      "html": "<section class=\"ds-window\" aria-label=\"Example document\"><header class=\"ds-titlebar\" tabindex=\"0\"><span class=\"ds-title\">about.md</span><span class=\"ds-type\">md</span></header><article class=\"ds-document\"><h2>About</h2><p>I build web products and the systems behind them.</p><p>Explore <a href=\"https://github.com/omar10594\">GitHub</a>.</p></article></section>",
      "css": ".ds-window{display:flex;flex-direction:column;overflow:hidden;max-width:440px;background:var(--surface,#0c1421);border:1px solid var(--line,#39475b);border-radius:10px;color:var(--ink,#eeeae5);box-shadow:0 22px 62px #01040a70;font-family:'Geist Mono',monospace;}.ds-titlebar{position:relative;display:flex;align-items:center;justify-content:center;flex:0 0 38px;padding:0 12px;background:var(--chrome,#182231);border-bottom:1px solid var(--line-quiet,#253246)}.ds-title{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:11px;color:#b9c5d8}.ds-type{position:absolute;right:12px;font-size:10px;color:var(--muted,#a3afc3)}.ds-titlebar:focus-visible,.ds-document a:focus-visible{outline:2px solid var(--orange,#ff9852);outline-offset:4px;}.ds-document{overflow:auto;padding:23px 25px 28px;font-size:12px;line-height:1.9;color:#c4ccda;overflow-wrap:anywhere}.ds-document h2{color:var(--ink,#eeeae5);font-size:15px;font-weight:500;line-height:1.6;margin:0 0 14px}.ds-document h2:before{content:\"# \";color:var(--orange,#ff9852)}.ds-document p{margin:0 0 16px;max-width:70ch}.ds-document a{color:var(--link,#9ebeff);text-underline-offset:4px;text-decoration-thickness:1px}.ds-document a:hover{color:var(--ink,#eeeae5)}"
    },
    {
      "name": "Task navigation",
      "kind": "nav",
      "refersTo": "task-navigation",
      "description": "Persistent text tasks; the active task is marked by an orange underline.",
      "html": "<nav class=\"ds-tasks\" aria-label=\"Open or restore windows\"><button type=\"button\" class=\"ds-task\" aria-pressed=\"false\">&gt;_ Terminal</button><button type=\"button\" class=\"ds-task ds-current\" aria-pressed=\"true\">about.md</button><button type=\"button\" class=\"ds-task\" aria-pressed=\"false\">contact.md</button></nav>",
      "css": ".ds-tasks{display:flex;align-items:center;gap:5px;overflow-x:auto;padding:7px 0;background:#0a111e;border-top:1px solid var(--line-quiet,#253246)}.ds-task{flex-shrink:0;position:relative;height:38px;padding:0 15px;border:0;background:none;color:#b7c2d5;font-size:11px;white-space:nowrap;cursor:pointer;font-family:'Geist Mono',monospace;}.ds-current{color:var(--ink,#eeeae5)}.ds-current:after{content:\"\";position:absolute;bottom:2px;left:15px;right:15px;height:2px;background:var(--orange,#ff9852)}.ds-minimized{color:#9ba7bc}.ds-task:hover{color:var(--orange,#ff9852)}.ds-task:focus-visible{outline:2px solid var(--orange,#ff9852);outline-offset:4px;}"
