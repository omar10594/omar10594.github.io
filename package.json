    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.30.1"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true
  }
