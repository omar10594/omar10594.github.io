---
---

<section id="contact" class="py-16 md:py-24 bg-gray-900 text-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-3xl font-bold mb-8">Get In Touch</h2>
    <p class="text-xl text-gray-400 mb-12 max-w-2xl mx-auto">
      I'm always open to discussing new projects, creative ideas, or opportunities to be part of your visions.
    </p>

    <div class="flex flex-col md:flex-row justify-center items-center gap-6">
      <button
        id="email-btn"
        class="group relative inline-flex items-center px-8 py-4 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-all duration-200 shadow-lg hover:shadow-blue-500/25 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-gray-900 focus:ring-blue-500"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-3" viewBox="0 0 20 20" fill="currentColor">
          <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
          <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
        </svg>
        <span id="email-text">Reveal Email</span>
        <div id="copy-feedback" class="absolute -top-10 left-1/2 transform -translate-x-1/2 bg-black text-white text-xs py-1 px-2 rounded opacity-0 transition-opacity duration-200">
          Copied!
        </div>
      </button>

      <div class="flex gap-6">
        <a 
          href="https://linkedin.com/in/omar10594" 
          target="_blank" 
          rel="noopener noreferrer"
          class="p-4 bg-gray-800 rounded-lg hover:bg-gray-700 transition-colors duration-200"
          aria-label="LinkedIn"
        >
          <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
          </svg>
        </a>
        <a 
          href="https://github.com/omar10594" 
          target="_blank" 
          rel="noopener noreferrer"
          class="p-4 bg-gray-800 rounded-lg hover:bg-gray-700 transition-colors duration-200"
          aria-label="GitHub"
        >
          <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const emailBtn = document.getElementById('email-btn');
  const emailText = document.getElementById('email-text');
  const feedback = document.getElementById('copy-feedback');
  
  // Base64 encoded: guillermo@lopezlopez.com.mx
  const encodedEmail = 'Z3VpbGxlcm1vQGxvcGV6bG9wZXouY29tLm14';

  emailBtn?.addEventListener('click', () => {
    try {
      const email = atob(encodedEmail);
      navigator.clipboard.writeText(email);
      
      if (emailText) emailText.textContent = email;
      
      // Show feedback
      if (feedback) {
        feedback.classList.remove('opacity-0');
        setTimeout(() => {
          feedback.classList.add('opacity-0');
        }, 2000);
      }

      // Optional: change location to mailto
      // window.location.href = `mailto:${email}`;
    } catch (e) {
      console.error('Failed to decode/copy email');
    }
  });
</script>
