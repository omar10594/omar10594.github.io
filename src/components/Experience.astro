---
const jobs = [
  {
    company: "SoSimple Capital",
    role: "Senior Full-Stack & Infrastructure Engineer (AI Solutions)",
    period: "December 2025 – Present",
    description: "Leading end-to-end delivery for the web platform and AI-enabled products. Managing full self-hosted infrastructure stack without managed cloud providers, ensuring 99%+ availability via orchestrated Docker containers, automated backups (Databasus), and comprehensive monitoring (Uptime Kuma, Dozzle). Tech stack includes Python/FastAPI, Next.js, and Express."
  },
  {
    company: "Play Business",
    role: "CTO & COO (Mar 2019 – Nov 2025) / External Consultant (Present)",
    period: "March 2019 – Present",
    description: " progressed from Full-Stack Developer to CTO & COO, leading the technology and operations of a regulated fintech. Directed a major platform modernization (Rails 5.2 to 6, Ruby 2.5 to 3), implemented Shape Up methodology, and oversaw core systems using PostgreSQL, Redis, and Sidekiq. Currently supporting as an external infrastructure consultant."
  },
  {
    company: "Nutriconsultor",
    role: "Chief Technology Officer (Co-founder)",
    period: "January 2016 – February 2019",
    description: "Co-founded and built the platform from scratch, combining technical leadership with hands-on development. Delivered a cross-platform solution (Web, Mobile/Cordova, Desktop/Electron) using Laravel, PostgreSQL, and AngularJS."
  }
];
---

<section id="experience" class="py-16 md:py-24 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl font-bold text-gray-900 mb-12">Experience</h2>
    <div class="relative border-l-2 border-gray-200 ml-3 space-y-12">
      {jobs.map((job) => (
        <div class="relative pl-8 md:pl-12">
          <div class="absolute -left-[9px] top-1 h-4 w-4 rounded-full bg-blue-600 border-4 border-white shadow-sm" />
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between mb-2">
            <h3 class="text-xl font-bold text-gray-900">{job.role}</h3>
            <span class="text-sm font-medium text-blue-600 sm:ml-4 flex-shrink-0">{job.period}</span>
          </div>
          <div class="text-lg font-semibold text-gray-700 mb-3">{job.company}</div>
          <p class="text-gray-600 leading-relaxed text-base">
            {job.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
