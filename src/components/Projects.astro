---
const projects = [
  {
    title: "Play Business",
    description: "Fintech investment platform. Led the transition to a regulated entity, modernized the legacy Rails codebase, and implemented core infrastructure for reliability and scale.",
    link: "https://playbusiness.mx/",
    tech: ["Ruby on Rails", "PostgreSQL", "Sidekiq", "Redis"]
  },
  {
    title: "SoSimple Capital",
    description: "AI-enabled financial platform. Building end-to-end web solutions and managing self-hosted infrastructure for high availability and performance.",
    link: "https://sosimple.capital/",
    tech: ["Python", "FastAPI", "React/Next.js", "Docker"]
  }
];
---

<section id="projects" class="py-16 md:py-24 bg-gray-50">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl font-bold text-gray-900 mb-12">Projects</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {projects.map((project) => (
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow duration-300 overflow-hidden flex flex-col">
          <div class="p-8 flex-1">
            <h3 class="text-xl font-bold text-gray-900 mb-3">
              <a href={project.link} target="_blank" rel="noopener noreferrer" class="hover:text-blue-600 transition-colors">
                {project.title} <span aria-hidden="true">&rarr;</span>
              </a>
            </h3>
            <p class="text-gray-600 mb-6 leading-relaxed">
              {project.description}
            </p>
            <div class="border-t border-gray-100 pt-4 mt-auto">
               <div class="flex flex-wrap gap-2">
                {project.tech.map((t) => (
                  <span class="text-xs font-medium text-gray-500 bg-gray-100 px-2 py-1 rounded">
                    {t}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
