---
const skills = [
  {
    category: "Backend",
    items: ["Ruby on Rails", "Python (FastAPI)", "Node.js (Express)", "Sidekiq", "Background Jobs"]
  },
  {
    category: "Frontend",
    items: ["React", "Next.js", "Tailwind CSS", "JavaScript/TypeScript"]
  },
  {
    category: "Infrastructure & DevOps",
    items: ["Docker (Compose, Portainer, Dockge)", "Self-hosted Reliability", "Monitoring (Uptime Kuma, Dozzle)", "Backups (Databasus)"]
  },
  {
    category: "Data",
    items: ["PostgreSQL", "Redis", "Performance Tuning"]
  },
  {
    category: "Leadership & Process",
    items: ["Shape Up Methodology", "Cross-functional Collaboration", "Technical Strategy", "Mentorship"]
  }
];
---

<section id="skills" class="py-16 md:py-24 bg-gray-50">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl font-bold text-gray-900 mb-12">Skills</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {skills.map((skillGroup) => (
        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
          <h3 class="text-lg font-semibold text-gray-900 mb-4 border-b border-gray-100 pb-2">
            {skillGroup.category}
          </h3>
          <div class="flex flex-wrap gap-2">
            {skillGroup.items.map((item) => (
              <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-50 text-blue-700">
                {item}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
