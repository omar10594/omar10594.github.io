---
import ProjectLayout from '../shared/ProjectLayout.astro';
import DeviceFrame from '../shared/DeviceFrame.astro';
import { projectById } from '../registry';

const longDays = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
const longMonths = [
  'January', 'February', 'March', 'April', 'May', 'June',
  'July', 'August', 'September', 'October', 'November', 'December',
];

type Tone = 'working' | 'short' | 'off' | 'outside';

interface DayCell {
  key: string;
  label: string;
  day: number;
  tone: Tone;
  today: boolean;
}

const monthCells: DayCell[] = [];
for (let i = 0; i < 35; i += 1) {
  const cellDate = new Date(Date.UTC(2026, 8, 28 + i));
  const weekday = cellDate.getUTCDay();
  const dayOfMonth = cellDate.getUTCDate();
  const outside = cellDate.getUTCMonth() !== 9;
  const today = !outside && dayOfMonth === 27;
  const tone: Tone = outside
    ? 'outside'
    : dayOfMonth === 28 || weekday === 0
      ? 'off'
      : weekday === 6
        ? 'short'
        : 'working';
  const state =
    tone === 'outside'
      ? 'outside this month'
      : tone === 'off'
        ? 'day off'
        : tone === 'short'
          ? 'shorter shift, 12:00 to 18:00'
          : today
            ? 'working day, 09:00 to 17:00, today'
            : 'working day, 09:00 to 17:00';
  monthCells.push({
    key: `${cellDate.getUTCFullYear()}-${cellDate.getUTCMonth()}-${dayOfMonth}`,
    label: `${longDays[weekday]}, ${longMonths[cellDate.getUTCMonth()]} ${dayOfMonth}, ${cellDate.getUTCFullYear()} — ${state}`,
    day: dayOfMonth,
    tone,
    today,
  });
}

const calendarWeeks = Array.from({ length: 5 }, (_, week) => monthCells.slice(week * 7, week * 7 + 7));
---

<ProjectLayout project={projectById('horarios')!} theme="light" font="inter">
  <div class="page" data-horarios-root>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="#demo" aria-label="Horarios — go to the demo">
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="5" width="18" height="16" rx="4"></rect>
              <path d="M3 9h18M8 3v4M16 3v4"></path>
              <path d="M12 12v3l2 1.5"></path>
            </svg>
          </span>
          <span class="brand-word">Horarios</span>
        </a>
        <nav class="site-nav" aria-label="Project sections">
          <a href="#demo">Demo</a>
          <a href="#story">Story</a>
          <a href="#build-notes">Build notes</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero" id="demo" aria-labelledby="hz-title">
        <div class="hero-copy">
          <h1 id="hz-title">Your next shift, at a glance.</h1>
          <p class="lede">Tomorrow's start time, your week and the details that matter to you.</p>
          <p class="contribution">A schedule tool designed for the person working the shift.</p>

          <div class="scenarios">
            <p class="scenario-label" id="hz-scenario-label">Try a sample day</p>
            <div class="scenario-group" role="group" aria-labelledby="hz-scenario-label">
              <button type="button" class="scenario" data-scenario="workday" aria-pressed="true">Workday</button>
              <button type="button" class="scenario" data-scenario="off" aria-pressed="false">Day off</button>
              <button type="button" class="scenario" data-scenario="split" aria-pressed="false">Split shift</button>
            </div>
            <p class="scenario-hint">Changes the sample shift, countdown and week row. Every record here is synthetic.</p>
          </div>

          <div class="jump-links">
            <a href="#story">Read the story</a>
            <a href="#build-notes">How it is built</a>
          </div>
        </div>

        <div class="hero-device">
          <DeviceFrame variant="android" label="Horarios shift preview with a fixed synthetic demo clock">
            <div slot="status" class="status-bar" aria-hidden="true">
              <span class="status-time">08:12</span>
              <span class="status-icons">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M2 9.5a14 14 0 0 1 20 0l-1.6 1.9a11.5 11.5 0 0 0-16.8 0zM6.1 13.6a8.6 8.6 0 0 1 11.8 0l-1.7 2a6.1 6.1 0 0 0-8.4 0zM10 17.7a3.2 3.2 0 0 1 4 0L12 20z"></path></svg>
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 17V9M9 17V6M14 17v-4M19 17V4"></path></svg>
                <svg viewBox="0 0 24 14" width="18" height="11" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="1" y="1.5" width="17" height="11" rx="2.5"></rect><path d="M21 5v4" stroke-linecap="round"></path><rect x="3.5" y="4" width="9" height="6" rx="1" fill="currentColor" stroke="none"></rect></svg>
              </span>
            </div>

            <div class="screen">
              <div class="screen-top">
                <div>
                  <p class="screen-brand">
                    <span class="screen-mark" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="8"></circle><path d="M12 8v4l2.5 1.8"></path></svg>
                    </span>
                    Horarios
                  </p>
                  <p class="screen-sub">Synthetic demo</p>
                </div>
                <span class="demo-badge">Demo</span>
              </div>

              <div class="view-tabs" role="tablist" aria-label="Schedule views">
                <button type="button" class="view-tab" role="tab" id="hz-tab-day" aria-controls="hz-panel-day" aria-selected="true" tabindex="0">Working Day</button>
                <button type="button" class="view-tab" role="tab" id="hz-tab-week" aria-controls="hz-panel-week" aria-selected="false" tabindex="-1">Week</button>
                <button type="button" class="view-tab" role="tab" id="hz-tab-month" aria-controls="hz-panel-month" aria-selected="false" tabindex="-1">Month</button>
              </div>

              <div class="panel" role="tabpanel" id="hz-panel-day" aria-labelledby="hz-tab-day" tabindex="0">
                <div class="shift-head">
                  <p class="kicker">Today</p>
                  <h2 class="shift-date">Tuesday, October 27, 2026</h2>
                </div>

                <div class="shift-card">
                  <div class="shift-top">
                    <p class="shift-label" data-shift-label>Working day</p>
                    <span class="status-chip" data-status-chip>Starts soon</span>
                  </div>
                  <p class="shift-time" data-shift-time>09:00 – 17:00</p>
                  <p class="countdown">
                    <strong data-countdown-value>48 min</strong>
                    <span data-countdown-text>until your shift starts</span>
                  </p>
                  <p class="shift-meta" data-shift-meta>Ends in 8 h 48 min · 8 h scheduled</p>
                  <p class="clock-line">
                    <span class="clock-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="8"></circle><path d="M12 8v4l2.5 1.8"></path></svg>
                    </span>
                    Demo clock <strong>08:12</strong>
                    <span class="clock-tag">fixed sample</span>
                  </p>
                </div>

                <div class="detail-card">
                  <p class="detail-title">Shared shift <span>fictional coworker</span></p>
                  <p class="detail-body" data-coworker>Sam Ortega · 10:00–16:00 overlap</p>
                </div>

                <p class="next-shift" data-next-shift>Next shift: Thursday, October 29 · 09:00–17:00</p>
              </div>

              <div class="panel" role="tabpanel" id="hz-panel-week" aria-labelledby="hz-tab-week" tabindex="0" hidden>
                <div class="shift-head">
                  <p class="kicker">Week of</p>
                  <h2 class="shift-date">October 26 – November 1, 2026</h2>
                </div>
                <table class="week-table">
                  <caption class="visually-hidden">Synthetic shifts for Monday, October 26 to Sunday, November 1, 2026</caption>
                  <thead>
                    <tr>
                      <th scope="col">Day</th>
                      <th scope="col">Shift</th>
                      <th scope="col">Hours</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <th scope="row">Mon 26</th>
                      <td>09:00–17:00</td>
                      <td>8 h</td>
                    </tr>
                    <tr class="is-today">
                      <th scope="row">Tue 27 <span class="today-tag">Today</span></th>
                      <td data-week-shift>09:00–17:00</td>
                      <td data-week-hours>8 h</td>
                    </tr>
                    <tr>
                      <th scope="row">Wed 28</th>
                      <td>Day off</td>
                      <td>—</td>
                    </tr>
                    <tr>
                      <th scope="row">Thu 29</th>
                      <td>09:00–17:00</td>
                      <td>8 h</td>
                    </tr>
                    <tr>
                      <th scope="row">Fri 30</th>
                      <td>09:00–17:00</td>
                      <td>8 h</td>
                    </tr>
                    <tr>
                      <th scope="row">Sat 31</th>
                      <td>12:00–18:00</td>
                      <td>6 h</td>
                    </tr>
                    <tr>
                      <th scope="row">Sun 1</th>
                      <td>Day off</td>
                      <td>—</td>
                    </tr>
                  </tbody>
                  <tfoot>
                    <tr>
                      <th scope="row" colspan="2">Scheduled this week</th>
                      <td data-week-total>38 h</td>
                    </tr>
                  </tfoot>
                </table>
              </div>

              <div class="panel" role="tabpanel" id="hz-panel-month" aria-labelledby="hz-tab-month" tabindex="0" hidden>
                <div class="shift-head">
                  <p class="kicker">Month</p>
                  <h2 class="shift-date">October 2026</h2>
                </div>
                <table class="month-table">
                  <caption class="visually-hidden">Synthetic shift calendar for October 2026</caption>
                  <thead>
                    <tr>
                      <th scope="col"><span aria-hidden="true">M</span><span class="visually-hidden">Monday</span></th>
                      <th scope="col"><span aria-hidden="true">T</span><span class="visually-hidden">Tuesday</span></th>
                      <th scope="col"><span aria-hidden="true">W</span><span class="visually-hidden">Wednesday</span></th>
                      <th scope="col"><span aria-hidden="true">T</span><span class="visually-hidden">Thursday</span></th>
                      <th scope="col"><span aria-hidden="true">F</span><span class="visually-hidden">Friday</span></th>
                      <th scope="col"><span aria-hidden="true">S</span><span class="visually-hidden">Saturday</span></th>
                      <th scope="col"><span aria-hidden="true">S</span><span class="visually-hidden">Sunday</span></th>
                    </tr>
                  </thead>
                  <tbody>
                    {calendarWeeks.map((week) => (
                      <tr>
                        {week.map((cell) => (
                          <td
                            class:list={['cal-cell', `tone-${cell.tone}`, cell.today && 'is-today']}
                            aria-label={cell.label}
                            aria-current={cell.today ? 'date' : undefined}
                            data-today-cell={cell.today ? 'true' : undefined}
                          >
                            <span class="cal-num">{cell.day}</span>
                            {cell.today && <span class="cal-dot" aria-hidden="true"></span>}
                          </td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
                <ul class="legend">
                  <li><span class="swatch swatch-working" aria-hidden="true"></span>Working day</li>
                  <li><span class="swatch swatch-short" aria-hidden="true"></span>Shorter shift</li>
                  <li><span class="swatch swatch-off" aria-hidden="true"></span>Day off</li>
                </ul>
              </div>

              <p class="screen-foot">Synthetic sample · fixed demo clock 08:12</p>
            </div>

            <span slot="caption">Web app preview · Android-style outline · synthetic schedule</span>
          </DeviceFrame>
        </div>
      </section>

      <section class="story" id="story" aria-labelledby="hz-story-title">
        <div class="section-head">
          <h2 id="hz-story-title">Built for the person working the shift.</h2>
        </div>
        <div class="story-body">
          <p>A schedule spreadsheet can contain everything you need and still make you work to find the answer. Horarios puts the personal questions first: when do I start tomorrow, how much time is left, and what does my week look like?</p>
          <p>I built it for the person working the shift. It is a small way to take one routine worry off their mind, with different views and useful details close at hand.</p>
          <p class="stance">Horarios is for your own planning. It is not an attendance, absence or break-monitoring tool.</p>
          <ul class="questions" aria-label="Questions Horarios answers">
            <li>
              <span class="q-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="8"></circle><path d="M12 8v4l2.5 1.8"></path></svg>
              </span>
              How long until my shift starts or ends?
            </li>
            <li>
              <span class="q-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="5" width="18" height="16" rx="3"></rect><path d="M3 9h18M8 3v4M16 3v4"></path></svg>
              </span>
              What does my week and month look like?
            </li>
            <li>
              <span class="q-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="9" cy="8" r="3.2"></circle><path d="M3.5 19a5.5 5.5 0 0 1 11 0M16 5.5a3 3 0 0 1 0 5.8M18 19a5 5 0 0 0-2.5-4.3"></path></svg>
              </span>
              Who shares the shift with me?
            </li>
          </ul>
        </div>
      </section>

      <section class="notes" id="build-notes" aria-labelledby="hz-notes-title">
        <div class="section-head">
          <h2 id="hz-notes-title">A useful layer over a familiar source.</h2>
        </div>
        <div class="notes-grid">
          <article class="note-card">
            <h3>From spreadsheet to personal view</h3>
            <p>Schedule data can originate in a spreadsheet. The useful part is presentation: the same records arranged around the employee's immediate questions instead of the source grid. </p>
          </article>
          <article class="note-card">
            <h3>A schedule you can keep with you</h3>
            <p>The original web app supports offline schedule access and changes between published snapshots. Different views make the same information useful in different moments.</p>
          </article>
          <article class="note-card">
            <h3>A useful point of view</h3>
            <p>A day view answers the immediate question. Week and month views make it easier to plan ahead. Shared-shift details help people see where their schedules overlap.</p>
          </article>
        </div>
        <p class="synthetic-note">Every shift, date and person on this page is fictional. Horarios is shown here as a product concept for employees, not as an attendance system.</p>
      </section>
    </main>

    <footer class="site-footer">
      <p>Horarios · Portfolio preview with synthetic data</p>
      <a href="#demo">Back to the demo</a>
    </footer>
  </div>
</ProjectLayout>

<script>
    const root = document.querySelector<HTMLElement>('[data-horarios-root]');

    if (root) {
      const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
      const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));

      const activateTab = (next: HTMLButtonElement, moveFocus = false) => {
        tabs.forEach((tab) => {
          const selected = tab === next;
          tab.setAttribute('aria-selected', String(selected));
          tab.tabIndex = selected ? 0 : -1;
        });
        panels.forEach((panel) => {
          panel.hidden = panel.id !== next.getAttribute('aria-controls');
        });
        if (moveFocus) next.focus();
      };

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => activateTab(tab));
        tab.addEventListener('keydown', (event) => {
          let targetIndex = index;
          if (event.key === 'ArrowRight') targetIndex = (index + 1) % tabs.length;
          else if (event.key === 'ArrowLeft') targetIndex = (index - 1 + tabs.length) % tabs.length;
          else if (event.key === 'Home') targetIndex = 0;
          else if (event.key === 'End') targetIndex = tabs.length - 1;
          else return;
          event.preventDefault();
          const target = tabs[targetIndex];
          if (target) activateTab(target, true);
        });
      });

      interface ScenarioState {
        label: string;
        chip: string;
        time: string;
        countdownValue: string;
        countdownText: string;
        meta: string;
        coworker: string;
        nextShift: string;
        weekShift: string;
        weekHours: string;
        weekTotal: string;
        monthTone: 'working' | 'short' | 'off';
        monthLabel: string;
      }

      const scenarios: Record<string, ScenarioState> = {
        workday: {
          label: 'Working day',
          chip: 'Starts soon',
          time: '09:00 – 17:00',
          countdownValue: '48 min',
          countdownText: 'until your shift starts',
          meta: 'Ends in 8 h 48 min · 8 h scheduled',
          coworker: 'Sam Ortega · 10:00–16:00 overlap',
          nextShift: 'Next shift: Thursday, October 29 · 09:00–17:00',
          weekShift: '09:00–17:00',
          weekHours: '8 h',
          weekTotal: '38 h',
          monthTone: 'working',
          monthLabel: 'Tuesday, October 27, 2026 — working day, 09:00 to 17:00, today',
        },
        off: {
          label: 'Day off',
          chip: 'Rest day',
          time: 'No shift today',
          countdownValue: 'Next shift',
          countdownText: 'Thursday, October 29 · 09:00',
          meta: 'Rest day · nothing scheduled today',
          coworker: 'No shared shift today',
          nextShift: 'Next shift: Thursday, October 29 · 09:00–17:00',
          weekShift: 'Day off',
          weekHours: '—',
          weekTotal: '30 h',
          monthTone: 'off',
          monthLabel: 'Tuesday, October 27, 2026 — day off, today',
        },
        split: {
          label: 'Split shift',
          chip: '2 segments',
          time: '09:00–13:00 · 17:00–21:00',
          countdownValue: '48 min',
          countdownText: 'until your first segment',
          meta: 'Ends in 12 h 48 min · 8 h across two segments',
          coworker: 'Sam Ortega · 10:00–13:00 overlap',
          nextShift: 'Next shift: Thursday, October 29 · 09:00–17:00',
          weekShift: '09:00–13:00 · 17:00–21:00',
          weekHours: '8 h',
          weekTotal: '38 h',
          monthTone: 'working',
          monthLabel: 'Tuesday, October 27, 2026 — split shift, 09:00 to 13:00 and 17:00 to 21:00, today',
        },
      };

      const setText = (selector: string, value: string) => {
        const node = root.querySelector<HTMLElement>(selector);
        if (node) node.textContent = value;
      };

      const applyScenario = (key: string) => {
        const state = scenarios[key];
        if (!state) return;
        setText('[data-shift-label]', state.label);
        setText('[data-status-chip]', state.chip);
        setText('[data-shift-time]', state.time);
        setText('[data-countdown-value]', state.countdownValue);
        setText('[data-countdown-text]', state.countdownText);
        setText('[data-shift-meta]', state.meta);
        setText('[data-coworker]', state.coworker);
        setText('[data-next-shift]', state.nextShift);
        setText('[data-week-shift]', state.weekShift);
        setText('[data-week-hours]', state.weekHours);
        setText('[data-week-total]', state.weekTotal);

        const todayCell = root.querySelector<HTMLElement>('[data-today-cell]');
        if (todayCell) {
          todayCell.classList.remove('tone-working', 'tone-short', 'tone-off', 'tone-outside');
          todayCell.classList.add(`tone-${state.monthTone}`);
          todayCell.setAttribute('aria-label', state.monthLabel);
        }

        root.querySelectorAll<HTMLButtonElement>('[data-scenario]').forEach((button) => {
          button.setAttribute('aria-pressed', String(button.dataset.scenario === key));
        });
      };

      root.querySelectorAll<HTMLButtonElement>('[data-scenario]').forEach((button) => {
        button.addEventListener('click', () => {
          if (button.dataset.scenario) applyScenario(button.dataset.scenario);
        });
      });
    }
  </script>

<style>
  .page {
    --pale: #f6f7fa;
    --ink: #00295a;
    --body: #24364f;
    --muted: #55657d;
    --line: #d9e1ec;
    --card: #ffffff;
    --blue: #0b57a4;
    min-height: 100vh;
    background: var(--pale);
    color: var(--body);
    font-family: inherit;
    overflow-x: clip;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(246, 247, 250, 0.94);
    border-bottom: 1px solid var(--line);
    backdrop-filter: blur(10px);
  }

  .header-inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0.3rem clamp(1rem, 4vw, 2.5rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 44px;
    color: var(--ink);
    font-weight: 700;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 9px;
    background: var(--ink);
    color: #fff;
  }

  .brand-word {
    font-size: 1rem;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    flex-wrap: wrap;
  }

  .site-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.7rem;
    border-radius: 8px;
    color: var(--muted);
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
  }

  .site-nav a:hover {
    color: var(--ink);
    background: #e8edf5;
  }

  main {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 clamp(1rem, 4vw, 2.5rem);
  }

  #demo,
  #story,
  #build-notes {
    scroll-margin-top: 76px;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 388px);
    align-items: center;
    gap: clamp(1.5rem, 5vw, 4.5rem);
    padding: clamp(1.6rem, 4.5vw, 4rem) 0 clamp(2rem, 5vw, 4rem);
  }

  .hero-copy {
    min-width: 0;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0 1rem;
    color: var(--blue);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .eyebrow-mark {
    display: inline-flex;
  }

  h1 {
    margin: 0 0 1rem;
    color: var(--ink);
    font-size: clamp(2.4rem, 5vw, 4rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    font-weight: 800;
    max-width: 12ch;
  }

  .lede {
    margin: 0 0 0.75rem;
    max-width: 34ch;
    color: var(--body);
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    line-height: 1.55;
