<script>
  const root = document.querySelector<HTMLElement>('[data-ml-artifact]');

  if (root) {
    const observation = root.querySelector<HTMLTextAreaElement>('[data-observation]');
    const observationField = root.querySelector<HTMLElement>('[data-report-observation]');
    const progressField = root.querySelector<HTMLElement>('[data-report-progress]');
    const nextField = root.querySelector<HTMLElement>('[data-report-next]');
    const paper = root.querySelector<HTMLElement>('[data-report-document]');
    const docStatus = root.querySelector<HTMLElement>('[data-doc-status]');
    const status = root.querySelector<HTMLElement>('[data-export-status]');
    const reviewed = root.querySelector<HTMLInputElement>('[data-reviewed-checkbox]');
    const exampleNote = observation?.defaultValue ?? '';

    const progressCopy = 'Turn-taking and listening: waits for a turn, listens to a classmate and builds on their idea. Group participation: contributes independently, with a remaining goal of inviting quieter classmates without an adult prompt.';
    const nextCopy = 'Try a short partner-reading routine with one invitation cue. Notice one moment when the student brings a quieter classmate into the conversation, then note what made it easier. Keep the next observation focused on that single goal.';

    const announce = (message: string) => {
      if (status) status.textContent = message;
    };

    const replaceText = (node: HTMLElement | null, value: string) => {
      if (node) node.textContent = value;
    };

    const setReviewState = (isReviewed: boolean) => {
      if (reviewed) reviewed.checked = isReviewed;
      if (paper) paper.dataset.reviewed = String(isReviewed);
      if (docStatus) docStatus.textContent = isReviewed ? 'Reviewed in this demo' : 'Draft for teacher review';
    };

    const generate = () => {
      if (!observation) return;
      const note = observation.value.trim();

      if (!note) {
        observation.setAttribute('aria-invalid', 'true');
        announce('Add an observation before generating a sample report.');
        observation.focus();
        return;
      }

      observation.removeAttribute('aria-invalid');
      replaceText(observationField, note);
      replaceText(progressField, progressCopy);
      replaceText(nextField, nextCopy);
      setReviewState(false);
      announce('Sample report updated from your note using the local template.');
    };

    root.querySelector<HTMLButtonElement>('[data-generate]')?.addEventListener('click', generate);

    root.querySelector<HTMLButtonElement>('[data-example]')?.addEventListener('click', () => {
      if (!observation) return;
      observation.value = exampleNote;
      observation.removeAttribute('aria-invalid');
      observation.focus();
      announce('Example note restored. Generate when ready.');
    });

    if (observation) {
      observation.addEventListener('input', () => observation.removeAttribute('aria-invalid'));
    }

    if (reviewed) {
      reviewed.addEventListener('change', () => {
        const isReviewed = reviewed.checked;
        if (paper) paper.dataset.reviewed = String(isReviewed);
        if (docStatus) docStatus.textContent = isReviewed ? 'Reviewed in this demo' : 'Draft for teacher review';
        announce(isReviewed ? 'Marked as reviewed for this demo.' : 'Returned to draft for teacher review.');
      });
    }

    for (const field of [observationField, progressField, nextField]) {
      field?.addEventListener('input', () => {
        if (!reviewed?.checked) return;
        setReviewState(false);
        announce('Report edited. Review reset — check the draft again when it is ready.');
      });
    }

    root.querySelector<HTMLButtonElement>('[data-download]')?.addEventListener('click', () => {
      const readField = (node: HTMLElement | null) => (node?.innerText ?? '').replace(/\n{3,}/g, '\n\n').trim();

      const observationText = readField(observationField);
      const progressText = readField(progressField);
      const nextText = readField(nextField);
      const reviewLine = reviewed?.checked
        ? 'Teacher review: marked as reviewed in this demo.'
        : 'Teacher review: pending in this demo.';

      const documentText = [
        'Miss Luciana — sample learning snapshot',
        'Fictional classroom · interactive reconstruction · not a student record',
        '',
        'Observation',
        observationText,
        '',
        'Learning progress',
        progressText,
        '',
        'Next steps',
        nextText,
        '',
        reviewLine,
      ].join('\n');

      try {
        const blob = new Blob([documentText], { type: 'text/plain;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.download = 'miss-luciana-sample-report.txt';
        link.style.display = 'none';
        root.appendChild(link);
        link.click();
        link.remove();
        window.setTimeout(() => URL.revokeObjectURL(url), 1000);
        announce('Sample report downloaded as a text file.');
      } catch {
        announce('Download is unavailable in this preview.');
      }
    });
  }
</script>
