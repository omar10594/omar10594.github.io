---
import ProjectLayout from '../shared/ProjectLayout.astro';
import { projectById } from '../registry';
import { Image } from 'astro:assets';
import penguin from '../../../assets/projects/penguin-teacher-cutout.png';

const project = projectById('miss-luciana')!;
---

<ProjectLayout project={project} font="hanken" theme="light">
  <div class="ml-page" id="top">
    <header class="ml-header">
      <div class="ml-wrap ml-header-inner">
        <a class="ml-brand" href="#top" aria-label="Miss Luciana case study — back to top">
          <span class="ml-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 6.5c-1.8-1.3-3.7-1.7-6-1.4v12.4c2.3-.3 4.2.1 6 1.4 1.8-1.3 3.7-1.7 6-1.4V5.1c-2.3-.3-4.2.1-6 1.4Z" />
              <path d="M12 6.5v12.4" />
            </svg>
          </span>
          <span class="ml-brand-text">
            <strong>Miss Luciana</strong>
            <span>Teacher tools · Case study</span>
          </span>
        </a>
        <nav class="ml-nav" aria-label="Miss Luciana case study">
          <a href="#story">Story</a>
          <a href="#build-notes">Build notes</a>
          <a class="ml-visit" href="https://missluciana.com/" target="_blank" rel="noopener noreferrer">
            Visit site
            <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 3h7v7" />
              <path d="M13 3 5 11" />
              <path d="M11 9v4H3V5h4" />
            </svg>
          </a>
        </nav>
      </div>
    </header>

    <main>
      <section class="ml-hero" aria-labelledby="ml-title">
        <div class="ml-wrap ml-hero-grid">
          <div class="ml-intro">
            <h1 class="ml-title" id="ml-title">More time for the work only a <span class="ml-title-accent">teacher</span> can do.</h1>
            <p class="ml-lede">Tools shaped by a teacher’s real classroom needs.</p>
            <p class="ml-credit">Teaching insight by Luciana. Product and engineering by Omar.</p>
            <div class="ml-mascot-row">
              <Image class="ml-mascot" src={penguin} width={440} format="webp" quality={85} loading="eager" alt="Miss Luciana's friendly teacher penguin" />
              <div class="ml-meet">
                <a href="https://soy.missluciana.com/" target="_blank" rel="noopener noreferrer">
                  Meet Luciana
                  <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h7v7M13 3 5 11M11 9v4H3V5h4" /></svg>
                </a>
                <p>The teacher whose classroom experience shaped this project.</p>
              </div>
            </div>
          </div>

          <div class="ml-artifact" data-ml-artifact>
            <div class="ml-artifact-head">
              <div class="ml-artifact-heading">
                <h2 id="ml-demo-title">A note becomes a report a teacher can review.</h2>
              </div>
              <span class="ml-sample-badge">Sample classroom</span>
            </div>

            <p class="ml-flow" aria-label="Observation to report to document">
              <span>Observation</span>
              <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M2 8h11" /><path d="m9 4 4 4-4 4" /></svg>
              <span>Report</span>
              <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M2 8h11" /><path d="m9 4 4 4-4 4" /></svg>
              <span>Document</span>
            </p>

            <div class="ml-compose">
              <div class="ml-field-head">
                <label for="ml-observation">Observation</label>
                <span>Editable note</span>
              </div>
              <textarea id="ml-observation" rows="4" aria-describedby="ml-local-hint" data-observation>During group reading, the student waited for a turn and then built on what a classmate said. They still need a prompt to invite quieter classmates into the conversation.</textarea>
              <div class="ml-compose-actions">
                <button class="ml-generate" type="button" data-generate>
                  <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2.5v11" /><path d="M2.5 8h11" /></svg>
                  Generate report
                </button>
                <button class="ml-example" type="button" data-example>Use example note</button>
              </div>
              <p class="ml-local-note" id="ml-local-hint">
                <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="6" /><path d="M8 7.4v3.8" /><path d="M8 4.9h.01" /></svg>
                <span>Local template, not a model call. The teacher edits and approves the result.</span>
              </p>
            </div>

            <div class="ml-paper" data-report-document data-reviewed="false">
              <div class="ml-paper-head">
                <div>
                  <p class="ml-paper-kicker">Learning snapshot · Sample</p>
                  <h3 id="ml-report-title">Turn-taking in group reading</h3>
                </div>
                <span class="ml-doc-status" data-doc-status>Draft for teacher review</span>
              </div>

              <div class="ml-paper-meta">
                <span>Fictional classroom</span>
                <span>Editable draft</span>
                <span>No student names</span>
              </div>

              <div class="ml-sections">
                <section class="ml-section">
                  <h4>Observation</h4>
                  <div class="ml-editable" contenteditable="true" role="textbox" aria-multiline="true" aria-label="Editable report observation" spellcheck="true" data-report-observation>During group reading, the student waited for a turn and then built on what a classmate said. They still need a prompt to invite quieter classmates into the conversation.</div>
                </section>
                <section class="ml-section">
                  <h4>Learning progress</h4>
                  <div class="ml-editable" contenteditable="true" role="textbox" aria-multiline="true" aria-label="Editable learning progress" spellcheck="true" data-report-progress>Turn-taking and listening: waits for a turn, listens to a classmate and builds on their idea. Group participation: contributes independently, with a remaining goal of inviting quieter classmates without an adult prompt.</div>
                </section>
                <section class="ml-section ml-section-next">
                  <h4>Next steps</h4>
                  <div class="ml-editable" contenteditable="true" role="textbox" aria-multiline="true" aria-label="Editable next steps" spellcheck="true" data-report-next>Try a short partner-reading routine with one invitation cue. Notice one moment when the student brings a quieter classmate into the conversation, then note what made it easier. Keep the next observation focused on that single goal.</div>
                </section>
              </div>

              <div class="ml-paper-foot">
                <label class="ml-review">
                  <input type="checkbox" data-reviewed-checkbox />
                  <span>I have reviewed this draft</span>
                </label>
                <div class="ml-export">
                  <button class="ml-download" type="button" data-download>
                    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v8" /><path d="m4.5 7 3.5 3.5L11.5 7" /><path d="M3 13h10" /></svg>
                    Download sample report
                  </button>
                  <p class="ml-export-status" aria-live="polite" data-export-status>Sample text · .txt</p>
                </div>
              </div>
            </div>

            <p class="ml-artifact-note">This reconstruction uses one local template about turn-taking. It does not interpret a new observation, call a model or create a student record. The live product supports real teacher workflows; this page isolates one step of that work.</p>
          </div>
        </div>
      </section>

      <section class="ml-story" id="story" aria-labelledby="ml-story-title" data-reveal>
        <div class="ml-wrap ml-story-grid">
          <div class="ml-section-intro">
            <h2 id="ml-story-title">It started with a teacher’s initiative.</h2>
          </div>
          <div class="ml-story-body">
            <p class="ml-story-lead">Miss Luciana began with Luciana, a teacher who was already finding creative ways to make her work better.</p>
            <p>She knew the classroom, the documents and the routines that took time away from her students. The first version brought shortcuts to useful tools together — a practical response to work she was already doing.</p>
            <p class="ml-pull">The early version was essentially a set of shortcuts: useful tools brought together around routines she already knew.</p>
            <p>The ideas and teaching knowledge came from her. I brought my development experience and worked with her to turn those needs into a product. The goal is to make the surrounding work easier so a teacher has more time and attention for students, and more of her own time back.</p>
            <p>That human attention is the point. The product is there to support a teacher’s judgment and relationships with students, not to replace them.</p>
            <div class="ml-credit-grid">
              <article>
                <p class="ml-credit-role">Luciana</p>
                <p>Teaching knowledge, classroom ideas, workflow requirements and the documents the product needed to support.</p>
                <a class="ml-profile-link" href="https://soy.missluciana.com/" target="_blank" rel="noopener noreferrer">Get to know Luciana</a>
              </article>
              <article>
                <p class="ml-credit-role">Omar</p>
                <p>Product design, engineering and implementation — turning those requirements into a working tool.</p>
              </article>
            </div>
          </div>
        </div>
      </section>

      <section class="ml-notes" id="build-notes" aria-labelledby="ml-notes-title" data-reveal>
        <div class="ml-wrap">
          <div class="ml-notes-head">
            <div>
              <h2 id="ml-notes-title">A small tool should protect attention, not demand it.</h2>
            </div>
            <p class="ml-notes-lede">The product brings classroom context, structured information and useful documents together, with the teacher making the decisions.</p>
          </div>

          <div class="ml-notes-list">
            <article>
              <div class="ml-note-copy">
                <h3>Start with the classroom</h3>
                <p>Luciana defined the workflows and the information teachers need. I translated those needs into tools for observations, reports, exams, planning and grades.</p>
              </div>
            </article>
            <article>
              <div class="ml-note-copy">
                <h3>From context to a document</h3>
                <p>The original application connects classroom information with reports and DOCX export. The useful outcome is a document the teacher can review, adjust and use in their work.</p>
              </div>
            </article>
            <article>
              <div class="ml-note-copy">
                <h3>Teacher control comes first</h3>
                <p>Every section of the report is editable, the draft is marked for review and the teacher can keep the text or discard it. The tool offers a starting point; it does not decide what a student needs.</p>
              </div>
            </article>
          </div>
        </div>
      </section>
    </main>

    <footer class="ml-footer">
      <div class="ml-wrap ml-footer-inner">
        <div>
          <p class="ml-footer-credit"><strong>Miss Luciana</strong> · Teaching insight by Luciana. Product and engineering by Omar.</p>
        </div>
        <div class="ml-footer-links">
          <a href="#top">Back to top</a>
          <a href="https://missluciana.com/" target="_blank" rel="noopener noreferrer">
            Visit site
            <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h7v7" /><path d="M13 3 5 11" /><path d="M11 9v4H3V5h4" /></svg>
          </a>
        </div>
      </div>
    </footer>
  </div>
</ProjectLayout>

<style>
  .ml-page {
    --ml-cream: #f8f6f2;
    --ml-ink: #1a1a2e;
    --ml-teal: #0f766e;
    --ml-teal-deep: #0b5f58;
    --ml-teal-soft: #e6f2ef;
    --ml-amber: #f59e0b;
    --ml-amber-soft: #fdf1dc;
    --ml-paper: #fffdf8;
    --ml-line: #e5ded2;
    --ml-muted: #66616c;
    background: var(--ml-cream);
    color: var(--ml-ink);
    min-height: 100vh;
    overflow-x: clip;
  }

  .ml-page [hidden] {
    display: none !important;
  }

  .ml-page h1,
  .ml-page h2,
  .ml-page h3,
  .ml-page h4,
  .ml-page p {
    margin: 0;
  }

  .ml-page h1,
  .ml-page h2,
  .ml-page h3,
  .ml-page h4 {
    font-family: var(--project-heading-font);
  }

  .ml-page :focus-visible {
    outline-color: var(--ml-teal);
  }

  .ml-wrap {
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
    padding-left: clamp(16px, 4.5vw, 48px);
    padding-right: clamp(16px, 4.5vw, 48px);
  }

  .ml-header {
    border-bottom: 1px solid rgba(26, 26, 46, 0.12);
    background: rgba(248, 246, 242, 0.94);
  }

  .ml-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    min-height: 78px;
    padding-top: 10px;
    padding-bottom: 10px;
  }

  .ml-brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    min-height: 44px;
    text-decoration: none;
  }

  .ml-mark {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--ml-teal);
    box-shadow: 0 0 0 4px rgba(15, 118, 110, 0.08);
    color: #fff;
  }

  .ml-brand-text {
    display: flex;
    flex-direction: column;
    gap: 3px;
    line-height: 1.1;
  }

  .ml-brand-text strong {
    color: var(--ml-ink);
    font-family: var(--project-heading-font);
    font-size: 16px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .ml-brand-text span {
    color: var(--ml-muted);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .ml-nav {
    display: flex;
    align-items: center;
    gap: 2px;
    flex-wrap: wrap;
  }

  .ml-nav a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 44px;
    padding: 10px 12px;
    border-radius: 3px;
    color: var(--ml-ink);
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.16s ease, color 0.16s ease;
  }

  .ml-nav a:hover {
    background: rgba(15, 118, 110, 0.08);
    color: var(--ml-teal);
  }

  .ml-nav .ml-visit {
    margin-left: 4px;
    padding: 10px 15px;
    background: var(--ml-teal);
    color: #fff;
  }

  .ml-nav .ml-visit:hover {
    background: var(--ml-teal-deep);
    color: #fff;
  }

  .ml-hero {
    padding-top: clamp(36px, 5.5vw, 72px);
    padding-bottom: clamp(42px, 6vw, 84px);
  }

  .ml-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: start;
  }

  .ml-intro {
    padding-top: clamp(0px, 1.5vw, 14px);
  }

  .ml-kicker {
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--ml-teal);
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .ml-kicker-mark {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ml-amber);
    flex: 0 0 auto;
  }

  .ml-title {
    max-width: 13ch;
    margin-top: 18px !important;
    color: var(--ml-ink);
    font-size: clamp(2.35rem, 4.9vw, 4.1rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    overflow-wrap: break-word;
  }

  .ml-title-accent {
    background: linear-gradient(transparent 80%, rgba(245, 158, 11, 0.34) 80%);
  }

  .ml-lede {
    max-width: 32ch;
    margin-top: 22px !important;
    color: #3d3a48;
    font-size: clamp(1.02rem, 1.5vw, 1.15rem);
    line-height: 1.55;
  }

  .ml-credit {
    max-width: 38ch;
    margin-top: 14px !important;
    padding-left: 11px;
    border-left: 1px solid var(--ml-amber);
    color: #3f3a46;
    font-size: 12.5px;
    font-weight: 600;
    line-height: 1.55;
  }

  .ml-mascot-row {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-top: clamp(26px, 4vw, 40px);
  }

  .ml-mascot {
    flex: 0 0 auto;
    width: clamp(150px, 16vw, 210px);
    max-width: 52%;
    height: auto;
  }

  .ml-mascot-row p {
    max-width: 24ch;
    color: var(--ml-muted);
    font-size: 13px;
    line-height: 1.55;
  }

  .ml-meet { flex: 1; min-width: 0; }
  .ml-meet a { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; color: var(--ml-teal-deep); font-size: 17px; font-weight: 800; text-decoration-thickness: 1px; }
  .ml-meet a:hover, .ml-profile-link:hover { color: var(--ml-ink); }
  .ml-profile-link { display: inline-flex; align-items: center; min-height: 44px; margin-top: 8px; color: var(--ml-teal-deep); font-size: 14px; font-weight: 700; }

  .ml-artifact {
    padding: clamp(16px, 2.4vw, 24px);
    border: 1px solid var(--ml-line);
    border-top: 4px solid var(--ml-amber);
    border-radius: 2px;
    background: var(--ml-paper);
    box-shadow: 0 24px 60px rgba(66, 52, 28, 0.08);
  }

  .ml-artifact-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--ml-line);
  }

  .ml-artifact-eyebrow {
    color: var(--ml-teal);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .ml-artifact-head h2 {
    max-width: 34ch;
    margin-top: 6px !important;
    color: var(--ml-ink);
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.18;
  }

  .ml-sample-badge {
    flex: 0 0 auto;
    padding: 5px 8px;
    border: 1px solid rgba(245, 158, 11, 0.35);
    border-radius: 2px;
    background: var(--ml-amber-soft);
    color: #7a4a00;
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .ml-flow {
    display: flex;
    align-items: center;
    gap: 7px;
    flex-wrap: wrap;
    padding: 12px 0;
    border-bottom: 1px dashed var(--ml-line);
    color: var(--ml-muted);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .ml-flow span:first-child {
    color: var(--ml-teal);
  }

  .ml-flow span:last-child {
    color: var(--ml-ink);
  }

  .ml-flow svg {
    flex: 0 0 auto;
    color: #a49a8b;
  }

  .ml-compose {
    padding-top: 14px;
  }

  .ml-field-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 6px;
  }

  .ml-field-head label {
    color: var(--ml-ink);
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .ml-field-head span {
    color: var(--ml-muted);
    font-size: 10.5px;
  }

  .ml-compose textarea {
    display: block;
    width: 100%;
    min-height: 96px;
    padding: 11px 12px;
    border: 1px solid var(--ml-line);
    border-radius: 2px;
    background: #fff;
    color: var(--ml-ink);
    font-size: 14.5px;
    line-height: 1.6;
    resize: vertical;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .ml-compose textarea:focus {
    border-color: var(--ml-teal);
    box-shadow: 0 0 0 3px rgba(15, 118, 110, 0.12);
  }

  .ml-compose textarea[aria-invalid="true"] {
    border-color: #b42318;
    box-shadow: 0 0 0 3px rgba(180, 35, 24, 0.1);
  }

  .ml-compose-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 10px;
  }

  .ml-page button {
    font-family: var(--project-font);
  }

  .ml-generate,
  .ml-example,
  .ml-download {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    min-height: 44px;
    padding: 10px 14px;
    border-radius: 2px;
    font-size: 12.5px;
    font-weight: 800;
    letter-spacing: 0.01em;
    transition: background-color 0.16s ease, border-color 0.16s ease, color 0.16s ease;
  }

  .ml-generate {
    border: 1px solid var(--ml-teal);
    background: var(--ml-teal);
    color: #fff;
  }

  .ml-generate:hover {
    border-color: var(--ml-teal-deep);
    background: var(--ml-teal-deep);
  }

  .ml-example {
    border: 1px solid var(--ml-line);
    background: transparent;
    color: var(--ml-ink);
  }

  .ml-example:hover {
    border-color: var(--ml-ink);
  }

  .ml-local-note {
    display: flex;
    align-items: flex-start;
    gap: 7px;
    margin-top: 9px !important;
    color: var(--ml-muted);
    font-size: 11.5px;
    line-height: 1.5;
  }

  .ml-local-note svg {
    flex: 0 0 auto;
    margin-top: 1px;
    color: var(--ml-teal);
  }

  .ml-paper {
    margin-top: 14px;
    border: 1px solid var(--ml-line);
    border-radius: 2px;
    background: #fff;
    box-shadow: inset 0 3px 0 rgba(15, 118, 110, 0.06);
  }

  .ml-paper-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 14px 10px;
    border-bottom: 1px solid var(--ml-line);
    background: var(--ml-paper);
  }

