<script>
  const root = document.querySelector<HTMLElement>('[data-pb-artifact]');

  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));

    const selectTab = (tab: HTMLButtonElement) => {
      for (const candidate of tabs) {
        const selected = candidate === tab;
        candidate.setAttribute('aria-selected', String(selected));
        candidate.tabIndex = selected ? 0 : -1;

        const panelId = candidate.getAttribute('aria-controls');
        const panel = panelId ? root.querySelector<HTMLElement>(`#${panelId}`) : null;
        if (panel) panel.hidden = !selected;
      }
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => selectTab(tab));

      tab.addEventListener('keydown', (event) => {
        let nextIndex: number | null = null;

        if (event.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
        if (event.key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
        if (event.key === 'Home') nextIndex = 0;
        if (event.key === 'End') nextIndex = tabs.length - 1;

        if (nextIndex !== null) {
          event.preventDefault();
          const next = tabs[nextIndex];
          if (next) {
            selectTab(next);
            next.focus();
          }
        }
      });
    });

    const selectedTab = tabs.find((tab) => tab.getAttribute('aria-selected') === 'true');
    if (selectedTab) selectTab(selectedTab);

    for (const button of root.querySelectorAll<HTMLButtonElement>('[data-details-toggle]')) {
      button.addEventListener('click', () => {
        const panelId = button.getAttribute('aria-controls');
        const panel = panelId ? root.querySelector<HTMLElement>(`#${panelId}`) : null;
        if (!panel) return;

        const expanded = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!expanded));
        panel.hidden = expanded;

        const label = button.querySelector<HTMLElement>('[data-details-label]');
        if (label) label.textContent = expanded ? 'View details' : 'Hide details';
      });
    }

    const updates = Array.from(root.querySelectorAll<HTMLElement>('[data-update]'));
    const reviewedCount = root.querySelector<HTMLElement>('[data-reviewed-count]');

    const syncReviews = () => {
      const reviewed = updates.filter((update) => update.dataset.reviewed === 'true').length;
      if (reviewedCount) reviewedCount.textContent = String(reviewed);
    };

    for (const button of root.querySelectorAll<HTMLButtonElement>('[data-review]')) {
      const update = button.closest<HTMLElement>('[data-update]');
      const label = button.querySelector<HTMLElement>('[data-review-label]');

      const setReviewed = (reviewed: boolean) => {
        button.setAttribute('aria-pressed', String(reviewed));
        if (update) update.dataset.reviewed = String(reviewed);
        if (label) label.textContent = reviewed ? 'Reviewed' : 'Mark reviewed';
      };

      setReviewed(button.getAttribute('aria-pressed') === 'true');

      button.addEventListener('click', () => {
        setReviewed(button.getAttribute('aria-pressed') !== 'true');
        syncReviews();
      });
    }

    syncReviews();

    const filter = root.querySelector<HTMLSelectElement>('[data-history-filter]');
    const activityRows = Array.from(root.querySelectorAll<HTMLElement>('[data-kind]'));
    const historyCount = root.querySelector<HTMLElement>('[data-history-count]');
    const historyEmpty = root.querySelector<HTMLElement>('[data-history-empty]');

    const applyFilter = () => {
      const value = filter?.value ?? 'all';
      let visible = 0;

      for (const row of activityRows) {
        const show = value === 'all' || row.dataset.kind === value;
        row.hidden = !show;
        if (show) visible += 1;
      }

      if (historyCount) historyCount.textContent = `${visible} ${visible === 1 ? 'entry' : 'entries'}`;
      if (historyEmpty) historyEmpty.hidden = visible !== 0;
    };

    filter?.addEventListener('change', applyFilter);
    applyFilter();
  }
</script>
