---
import { projectRoute, type ProjectDefinition } from '../registry';
interface Props { project: ProjectDefinition; theme?: 'light' | 'dark'; font?: 'inter' | 'rubik' | 'hanken'; }
const { project, theme = 'light', font = 'inter' } = Astro.props;
const canonical = new URL(projectRoute(project.id), Astro.site);
---
<!doctype html>
<html lang="en" data-theme={theme} data-font={font}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{project.title} — Guillermo Omar López López</title>
  <meta name="description" content={project.summary} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="theme-color" content={theme === 'dark' ? '#080b10' : '#f8f7f3'} />
  <meta property="og:title" content={project.title + ' — A project by Omar'} />
  <meta property="og:description" content={project.summary} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL('/social-card.png', Astro.site)} />
  <meta name="twitter:card" content="summary_large_image" />
</head>
<body>
  <a class="workspace-return" href={`/#file=${encodeURIComponent('/home/omar/projects/README.md')}`}>Back to Omar's workspace</a>
  <slot />
  <script>
    const embedded = window.parent !== window;
    document.documentElement.classList.toggle('is-embedded', embedded);
    if (embedded) {
      for (const event of ['pointerdown', 'focusin']) {
        document.addEventListener(event, () => window.parent.postMessage({ type: 'portfolio-project-focus' }, window.location.origin));
      }
    }
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) if (entry.isIntersecting) {
          entry.target.classList.add('is-revealed');
          observer.unobserve(entry.target);
        }
      }, { threshold: .12 });
      document.querySelectorAll('[data-reveal]').forEach((node) => observer.observe(node));
    }
  </script>
</body>
</html>
<style is:global>
  @font-face{font-family:ProjectInter;src:url('/fonts/project-inter.ttf') format('truetype');font-weight:100 900;font-display:swap}
  @font-face{font-family:ProjectHanken;src:url('/fonts/project-hanken.ttf') format('truetype');font-weight:100 900;font-display:swap}
  @font-face{font-family:ProjectRubik;src:url('/fonts/project-rubik.ttf') format('truetype');font-weight:300 900;font-display:swap}
  @font-face{font-family:ProjectLato;src:url('/fonts/project-lato.ttf') format('truetype');font-weight:400;font-display:swap}
  :root{color-scheme:light;--project-font:ProjectInter,system-ui,sans-serif;--project-heading-font:var(--project-font);font-family:var(--project-font);color:#101624;background:#f8f7f3}
  :root[data-theme=dark]{color-scheme:dark;background:#080b10;color:#f6f6f6}
  :root[data-font=hanken]{--project-font:ProjectHanken,system-ui,sans-serif}
  :root[data-font=rubik]{--project-font:ProjectLato,system-ui,sans-serif;--project-heading-font:ProjectRubik,system-ui,sans-serif}
  *{box-sizing:border-box}body{margin:0}button,input,textarea,select{font:inherit}button,a,input,textarea,select{-webkit-tap-highlight-color:transparent}
  h1,h2,h3{font-family:var(--project-heading-font);text-wrap:balance}p{line-height:1.65}img{max-width:100%;height:auto}button{cursor:pointer}
  a{color:inherit;text-underline-offset:.22em}a:focus-visible,button:focus-visible,input:focus-visible,textarea:focus-visible,summary:focus-visible{outline:3px solid currentColor;outline-offset:4px}
  ::selection{background:#b6d9e9;color:#101624}html{scroll-behavior:smooth;scrollbar-width:thin;scrollbar-color:#87929c transparent}
  .workspace-return{display:block;padding:10px 24px;background:#111b2a;color:#dbe7fa;font-size:12px;text-decoration:none}
  .is-embedded .workspace-return{display:none}
  [data-reveal].is-revealed{animation:project-reveal .6s cubic-bezier(.16,1,.3,1) both}
  @keyframes project-reveal{from{transform:translateY(12px)}to{transform:translateY(0)}}
  @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{animation:none!important;transition:none!important}}
</style>
